@model LinkUpProject.Application.ViewModels.Account.ProfileViewModel

@{
    ViewData["Title"] = Model.IsEditing ? "Editar Perfil" : "Mi Perfil";
    var avatarLetter = string.IsNullOrWhiteSpace(Model.FirstName) ? "U" : Model.FirstName[..1].ToUpper();
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm mx-auto mb-3 position-relative" style="width: 120px; height: 120px; font-size: 3.5rem; font-weight: bold; overflow: hidden;">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Foto de perfil" class="w-100 h-100" style="object-fit: cover;" />
                    }
                    else
                    {
                        @avatarLetter
                    }
                </div>
                <h3 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h3>
                <p class="text-muted">@@@Model.UserName</p>
            </div>

            <div class="card-body px-5 pb-4">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">@successMessage</div>
                }

                <h5 class="fw-bold border-bottom pb-2 mb-3">Informacion Personal</h5>

                @if (Model.IsEditing)
                {
                    <form asp-controller="Account" asp-action="EditProfile" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="UserName" type="hidden" />
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="ProfilePictureUrl" type="hidden" />
                        <input asp-for="IsEditing" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold">Nombre</label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Correo Electronico</label>
                            <input value="@Model.Email" class="form-control" disabled />
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefono</label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-light fw-bold px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary fw-bold px-4">Guardar Cambios</button>
                        </div>
                    </form>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-semibold">Nombre</span>
                            <span class="fw-medium">@Model.FirstName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-semibold">Apellido</span>
                            <span class="fw-medium">@Model.LastName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-semibold">Correo Electronico</span>
                            <span class="fw-medium">@Model.Email</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-semibold">Telefono</span>
                            <span class="fw-medium">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "No especificado" : Model.PhoneNumber)</span>
                        </li>
                    </ul>

                    <div class="d-flex justify-content-between gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light fw-bold px-4">Volver al Feed</a>
                        <a asp-controller="Account" asp-action="EditProfile" class="btn btn-primary fw-bold px-4">Editar Perfil</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-danger fw-bold px-4">Cerrar Sesion</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
